{
  "routes": [
    {
        "src": "^/(.*)\\.xlsx$",
        "status": 404
    },
    {
        "handle": "filesystem"
    },
    {
        "src": "/(.*)",
        "dest": "/$1"
    },
    {
        "src": ".*\\.(png|jpg|jpeg|webp|svg|gif)$",
        "status": 403
    },
    {
      "src": "/img/(.*)",
      "headers": {
        "x-blocked": "true"
      },
      "status": 404
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/index.html"
    },
    {
      "src": ".*",
      "status": 404
    }
  ]
}
